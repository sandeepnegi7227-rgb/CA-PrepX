{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:level(foundation|inter|intermediate|final)",
      "destination": "/index.html"
    },
    {
      "source": "/:level(foundation|inter|intermediate|final)/:rest*",
      "destination": "/index.html"
    }
  ]
}
